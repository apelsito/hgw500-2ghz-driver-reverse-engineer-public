diff --git a/drivers/net/wireless/realtek/rtlwifi/pci.c b/drivers/net/wireless/realtek/rtlwifi/pci.c
--- a/drivers/net/wireless/realtek/rtlwifi/pci.c
+++ b/drivers/net/wireless/realtek/rtlwifi/pci.c
@@ -851,8 +851,14 @@ static irqreturn_t _rtl_pci_interrupt(int irq, void *dev_id)
 			trace_id, irq, rtlpci->irq_enabled);
 
 	if (rtlpci->irq_enabled == 0) {
+		if (rtlpci->irq_line_lifecycle_managed) {
+			if (trace)
+				pr_info("OMRTL stage=irq-deferred-handled id=%u irq=%d reason=managed-deferred\n",
+					trace_id, irq);
+			return IRQ_HANDLED;
+		}
 		if (trace)
-			pr_info("OMRTL stage=irq-skip-disabled id=%u irq=%d\n",
+			pr_info("OMRTL stage=irq-skip-disabled id=%u irq=%d reason=shared-not-ours\n",
 				trace_id, irq);
 		return IRQ_NONE;
 	}
