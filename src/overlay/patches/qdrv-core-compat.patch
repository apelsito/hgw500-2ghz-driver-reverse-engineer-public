 		nbp_switchdev_allowed_egress(p, skb) &&
+#ifdef CONFIG_OPENMITRASTAR_QDRV_COMPAT
+		openmitrastar_br_ap_isolate_should_forward(p, skb) &&
+#endif
 		!br_skb_isolated(p, skb);
