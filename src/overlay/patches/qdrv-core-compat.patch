 					       struct net_bridge_port *source,
 					       const unsigned char *addr,
diff --git a/net/bridge/br_forward.c b/net/bridge/br_forward.c
--- a/net/bridge/br_forward.c
+++ b/net/bridge/br_forward.c
@@ -15,8 +15,41 @@
 #include <linux/skbuff.h>
 #include <linux/if_vlan.h>
 #include <linux/netfilter_bridge.h>
+#include <linux/openmitrastar_bridge.h>
 #include "br_private.h"
 
+#ifdef CONFIG_OPENMITRASTAR_QDRV_COMPAT
+static int br_ap_isolate_enabled;
+
+void br_set_ap_isolate(int enable)
+{
+	WRITE_ONCE(br_ap_isolate_enabled, !!enable);
+}
+EXPORT_SYMBOL(br_set_ap_isolate);
+
+int br_get_ap_isolate(void)
+{
+	return READ_ONCE(br_ap_isolate_enabled);
+}
+EXPORT_SYMBOL(br_get_ap_isolate);
+
+static bool openmitrastar_br_ap_isolate_should_forward(
+		const struct net_bridge_port *p, const struct sk_buff *skb)
+{
+	if (skb->dev == p->dev)
+		return !br_get_ap_isolate() &&
+			!QTN_FLAG_IS_INTRA_BSS(skb->dev->qtn_flags);
+
+	if ((QTN_FLAG_IS_BSS_ISOLATE(skb->dev->qtn_flags) &&
+			(p->dev->qtn_flags & QTN_FLAG_WIFI_DEVICE)) ||
+		((skb->dev->qtn_flags & QTN_FLAG_WIFI_DEVICE) &&
+			QTN_FLAG_IS_BSS_ISOLATE(p->dev->qtn_flags)))
+		return false;
+
+	return true;
+}
+#endif
